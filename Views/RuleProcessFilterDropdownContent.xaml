<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="lunagalLauncher.Views.RuleProcessFilterDropdownContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:lunagalLauncher.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:ExePathToIconImageSourceConverter x:Key="ExePathToIconImageSourceConverter"/>
    </UserControl.Resources>
    <StackPanel MaxHeight="420">
        <ScrollViewer x:Name="RuleProcessListScrollViewer"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="320" Padding="24,12,24,8">
            <ItemsControl x:Name="RuleProcessItemsControl"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" Margin="0,2" CornerRadius="6" Padding="8,6"
                                Tapped="RuleProcessItemBorder_Tapped"
                                PointerEntered="RuleProcessItemBorder_PointerEntered"
                                PointerExited="RuleProcessItemBorder_PointerExited">
                            <Grid ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                          MinWidth="0" Padding="0" Margin="0,0,8,0"
                                          IsHitTestVisible="False" Tag="{Binding}"/>
                                <Image Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center" Stretch="Uniform"
                                       Source="{Binding Converter={StaticResource ExePathToIconImageSourceConverter}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="20"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,6,16,6"/>
        <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center" Margin="24,0,24,12">
            <Button Click="RuleProcessSelectAll_Click" MinWidth="70" Height="30" CornerRadius="15" Padding="10,5" FontSize="11.5">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="✓" FontSize="11.5"/>
                    <TextBlock Text="全选"/>
                </StackPanel>
            </Button>
            <Button Click="RuleProcessClearChecks_Click" MinWidth="70" Height="30" CornerRadius="15" Padding="10,5" FontSize="11.5">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="✗" FontSize="11.5"/>
                    <TextBlock Text="清空"/>
                </StackPanel>
            </Button>
            <Button Click="RuleProcessDeleteSelected_Click" MinWidth="70" Height="30" CornerRadius="15" Padding="10,5" FontSize="11.5">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="🗑" FontSize="11.5"/>
                    <TextBlock Text="删除"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
