<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <OutputType>WinExe</OutputType>

        <!-- WinUI 3 -->
        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

        <!-- Project Options -->
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>lunagalLauncher</RootNamespace>

        <!-- 构建期代码样式与 Roslyn 分析器：清理未使用成员、冗余 using 等 -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- 启用后构建期可报告 IDE0005（冗余 using）；CS1591 对无 XML 的 public API 噪声过大故抑制 -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <!-- WinUI + COM + Newtonsoft：不在构建期跑 IL 裁剪分析（Release 否则大量 IL20xx 噪声；发布若启用 Trim 需单独验证）。 -->
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>

        <!-- App Options -->
        <UseRidGraph>true</UseRidGraph>
        <Platforms>x86;x64;ARM64</Platforms>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

        <!--
          .NET 8+ 默认关闭 built-in COM interop，导致 `Type.GetTypeFromCLSID`、
          `Activator.CreateInstance(comType)`、以及 `[MarshalAs(UnmanagedType.Interface)]` 出参
          全部抛 "Built-in COM has been disabled via a feature switch"。
          本项目使用 IFileOpenDialog / IFileSaveDialog（COM）作为文件对话框实现（见 Utils/Win32FileDialog.cs），
          必须显式启用 built-in COM 支持，否则浏览按钮点击后不会弹出任何窗口。
          参考：https://aka.ms/dotnet-illink/com
        -->
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

        <!-- 禁用 XAML 生成的 Main，入口见 Program.cs。 -->
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    </PropertyGroup>

    <!--
      多平台 WinUI：命令行 dotnet run 未传 -p:Platform 时，默认探测路径为 bin\Debug\...\exe，
      实际输出在 bin\{Platform}\Debug\...\win-{rid}\，会报「系统找不到指定的文件」。
      本项目主目标为 x64：未指定或 AnyCPU 时默认 x64（需 ARM64 时显式 -p:Platform=ARM64）。
    -->
    <PropertyGroup>
        <Platform Condition="'$(Platform)' == '' OR '$(Platform)' == 'AnyCPU'">x64</Platform>
    </PropertyGroup>

    <ItemGroup>
        <RuntimeHostConfigurationOption Include="System.Runtime.InteropServices.BuiltInComInterop.IsSupported" Value="true" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\SplashScreen.scale-200.png" />
        <Content Include="Assets\LockScreenLogo.scale-200.png" />
        <Content Include="Assets\Square150x150Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
        <Content Include="Assets\StoreLogo.png" />
        <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="lunagalLauncher.slnx" />
    </ItemGroup>

    <!-- 排除备份目录 -->
    <ItemGroup>
        <Compile Remove="备份*\**" />
        <Compile Remove="澶囦唤*\**" />
        <Page Remove="备份*\**" />
        <Page Remove="澶囦唤*\**" />
        <None Include="备份*\**" />
        <None Include="澶囦唤*\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.*" />

        <Manifest Include="$(ApplicationManifest)" />

        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

        <PackageReference Include="Serilog" Version="4.3.0" />

        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />

        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

        <!-- 文件日志异步落盘：UI 线程 Log.Information 入队即返回，避免同步 I/O 抢占渲染 -->
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />

        <PackageReference Include="System.Management" Version="10.0.2" />
        
        <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    </ItemGroup>

    <!-- 
        Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
        Tools extension to be activated for this project even if the Windows App SDK Nuget
        package has not yet been restored.
    -->
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix" />
    </ItemGroup>

    <!-- 
        Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution 
        Explorer "Package and Publish" context menu entry to be enabled for this project even if 
        the Windows App SDK Nuget package has not yet been restored.
    -->
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>
</Project>
